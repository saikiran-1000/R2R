class WorkQueueAudit(Base):
    __tablename__ = 'r2r_work_queue_audit'
    __table_args__ = {"schema": db_schema}

    id = Column(Integer, primary_key=True, autoincrement=True)
    wq_id = Column(Integer, nullable=False)
    status = Column(String, nullable=True)
    sub_status = Column(String, nullable=True)
    stage = Column(String, nullable=True)
    sub_stage = Column(String, nullable=True)
    action_item = Column(String, nullable=True)
    description = Column(String, nullable=True)
    created_by = Column(String, nullable=True, default="system")
    created_date = Column(DateTime, default=func.now())
    updated_date = Column(DateTime, default=func.now(), onupdate=func.now())
    updated_by = Column(String, nullable=True, default="system")

    @classmethod
    def to_model(cls, wq_id:int, status:str=None, sub_status:str=None, stage:str=None, sub_stage:str=None, action_item:str=None, description:str=None)-> 'WorkQueueAudit':
        return cls(
            wq_id=wq_id,
            status=status,  
            sub_status=sub_status,      
            stage=stage,
            sub_stage=sub_stage,    
            action_item=action_item,
            description=description
            
         )
